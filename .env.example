# OpenAI-compatible chat model. Leave LLM_API_KEY empty for local demo mode.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Local web server used by run.bat / documented uvicorn commands.
APP_HOST=127.0.0.1
APP_PORT=8000

# SQLite database. Tests must override this with a temporary file.
DATABASE_PATH=./data/personal_ai_os.db

# Opt-in only: allow the recommendation engine to use a cloud model for rewrites.
RECOMMENDATIONS_USE_MODEL=0

# Connector credential encryption. Normally leave PAOS_SECRET_KEY unset and let
# the application create a local key file. Do not commit a real key.
PAOS_SECRET_KEY=
PAOS_SECRET_KEY_PATH=./data/secret.key

# Opt-in automatic reminder lifecycle. Keep disabled unless you understand the
# SQLite lease/fencing semantics. All processes may start; only the lease holder runs tick.
REMINDER_SCHEDULER_ENABLED=0
REMINDER_SCHEDULER_POLL_SECONDS=60
REMINDER_SCHEDULER_SHUTDOWN_TIMEOUT_SECONDS=35

# Opt-in fake-test notification delivery worker for C-C-2d.
# This never enables email, SMS, webhook, desktop, or cloud delivery; only fake_test is allowed.
NOTIFICATION_DELIVERY_ENABLED=0
NOTIFICATION_DELIVERY_POLL_SECONDS=30
NOTIFICATION_DELIVERY_SHUTDOWN_TIMEOUT_SECONDS=35
